#!/usr/bin/env bash

source "/Users/magtastic/.config/sketchybar/colors.sh"

PLUGIN_DIR="/Users/magtastic/.config/sketchybar/plugins"
ITEM_DIR="/Users/magtastic/.config/sketchybar/items"

sketchybar --bar sticky=on             \
                 display=all           \
                 height=36             \
                 blur_radius=30        \
                 position=top          \
                 padding_left=10       \
                 padding_right=10      \
                 color=$COLOR_BAR      \
                 topmost=off           \
                 shadow=off            \
                 corner_radius=0       \
                 font_smoothing=on

sketchybar --default updates=when_shown                        \
                     drawing=on                                \
                     label.font="SF Pro Display:Semibold:13.0" \
                     label.color=$COLOR_TEXT                   \
                     label.padding_left=4                      \
                     label.padding_right=4                     \
                     label.y_offset=0                          \
                     icon.font="SF Pro Display:Semibold:14.0"  \
                     icon.color=$COLOR_TEXT                    \
                     icon.padding_left=4                       \
                     icon.padding_right=4                      \
                     background.corner_radius=6                \
                     background.height=24                      \
                     background.padding_left=2                 \
                     background.padding_right=2

# AeroSpace fires this event on every workspace switch (configured via
# exec-on-workspace-change in aerospace.toml). Must be declared before any
# item subscribes to it.
sketchybar --add event aerospace_workspace_change

source "$ITEM_DIR/space.list.sh"
source "$ITEM_DIR/calendar.clock.sh"
source "$ITEM_DIR/sound.output.sh"
source "$ITEM_DIR/network.wifi.sh"
source "$ITEM_DIR/input.source.sh"
source "$ITEM_DIR/battery.sh"

# Right-side status group: subtle pill background tying icons together.
sketchybar --add bracket status battery calendar.clock sound.output network.wifi input \
           --set status background.color=$COLOR_GROUP_BG                               \
                        background.corner_radius=8                                     \
                        background.height=26                                           \
                        background.padding_left=4                                      \
                        background.padding_right=4

# Slide bar out of the way when the native menu bar is summoned.
pkill -f "bar.autohide.ts" 2>/dev/null
"$PLUGIN_DIR/bar.autohide.ts" &

sketchybar --update

echo "sketchybar configuration loaded.."
